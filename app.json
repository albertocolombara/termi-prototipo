{
  "expo": {
    "name": "Termi protótipo",
    "slug": "termi-prototipo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.albertocolombara.termiprototipo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0F13",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.albertocolombara.termiprototipo",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#F28C28"
        }
      ],
      "expo-asset",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Geist",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/geist/400Regular/Geist_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/geist/500Medium/Geist_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/geist/600SemiBold/Geist_600SemiBold.ttf",
                    "weight": 600
                  }
                ]
              },
              {
                "fontFamily": "Geist Pixel",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/geist-pixel/GeistPixel-Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Geist Pixel Circle",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/geist-pixel/GeistPixel-Circle.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Geist Pixel Grid",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/geist-pixel/GeistPixel-Grid.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Geist Pixel Triangle",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/geist-pixel/GeistPixel-Triangle.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Geist Pixel Line",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/geist-pixel/GeistPixel-Line.ttf",
                    "weight": 400
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./node_modules/@expo-google-fonts/geist/400Regular/Geist_400Regular.ttf",
              "./node_modules/@expo-google-fonts/geist/500Medium/Geist_500Medium.ttf",
              "./node_modules/@expo-google-fonts/geist/600SemiBold/Geist_600SemiBold.ttf",
              "./assets/fonts/geist-pixel/GeistPixel-Regular.ttf",
              "./assets/fonts/geist-pixel/GeistPixel-Circle.ttf",
              "./assets/fonts/geist-pixel/GeistPixel-Grid.ttf",
              "./assets/fonts/geist-pixel/GeistPixel-Triangle.ttf",
              "./assets/fonts/geist-pixel/GeistPixel-Line.ttf"
            ]
          }
        }
      ]
    ],
    "backgroundColor": "#0E0F13"
  }
}
